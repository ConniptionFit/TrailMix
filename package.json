{
  "name": "trailmix",
  "version": "0.5.1",
  "description": "Local-first, privacy-centric AI note-taking and transcription desktop application",
  "main": "main.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/ConniptionFit/TrailMix.git"
  },
  "homepage": "https://github.com/ConniptionFit/TrailMix#readme",
  "bugs": {
    "url": "https://github.com/ConniptionFit/TrailMix/issues"
  },
  "files": [
    "README.md",
    "CHANGELOG.md",
    "assets/",
    "docs/",
    "legacy/",
    "main.js",
    "main/",
    "preload.js",
    "encryption.js",
    "lib/",
    "services/",
    "workers/",
    "windows/",
    "renderer/",
    "scripts/"
  ],
  "scripts": {
    "start": "electron .",
    "package": "electron-builder --linux AppImage",
    "package:dir": "electron-builder --linux dir",
    "screenshots": "electron scripts/capture-screenshots.js"
  },
  "keywords": [
    "local-first",
    "ai",
    "transcription",
    "notes",
    "privacy",
    "electron"
  ],
  "author": "TrailMix Team",
  "license": "MIT",
  "devDependencies": {
    "electron": "^31.7.7",
    "electron-builder": "^25.1.8"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "sqlite3": "^6.0.1"
  },
  "build": {
    "appId": "com.trailmix.app",
    "productName": "TrailMix",
    "directories": {
      "output": "dist",
      "buildResources": "assets"
    },
    "files": [
      "**/*",
      "!bin/cmake/**",
      "!bin/cmake",
      "!dist/**",
      "!legacy/**",
      "!.git/**"
    ],
    "extraResources": [
      {
        "from": "bin/whisper.cpp",
        "to": "whisper.cpp",
        "filter": ["**/*"]
      }
    ],
    "linux": {
      "target": ["AppImage"],
      "category": "Office",
      "icon": "assets/logo.png",
      "artifactName": "TrailMix-${version}-${arch}.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "ConniptionFit",
        "repo": "TrailMix"
      }
    ]
  },
  "allowScripts": {
    "electron@31.7.7": true,
    "sqlite3": true
  }
}
