<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Local-only by construction, zero network permission (restored 2026-09-13, Phase 3 of
         the sherpa-onnx migration): AI-01 speaker diarization ("Speaker labels") migrated off
         Picovoice Falcon onto sherpa-onnx in Phase 1, and AI-12's Eagle ("Known speakers") —
         the last consumer of the one disclosed INTERNET exception this app ever had — was
         deleted outright in this phase, scaffolding and all, since it had no enrollment UI and
         therefore no real caller yet. Both AccessKey-gated features are gone; nothing in this
         app declares INTERNET anymore. See the plan at `i-have-a-github-prancy-lovelace.md` and
         the Falcon/Eagle rows in this repo's CLAUDE.md, and [[Security and Privacy]] for the
         full history. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- The ML Kit GenAI client library's manifest merges INTERNET/ACCESS_NETWORK_STATE back
         in on its own — model downloads are performed by the separate AICore system app, not
         this process, so neither is actually needed. Re-verify both strips with
         `aapt2 dump permissions` after any dependency change, not just this one. -->
    <uses-permission android:name="android.permission.INTERNET" tools:node="remove" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" tools:node="remove" />
    <!-- Optional, requested at runtime only when the user taps the Home
         "Upcoming" card. Read-only. -->
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <!-- Optional, requested at runtime only when the user opens the photo
         picker on the export/share sheet. Read-only — matches photos taken
         during a note's timeframe so they can be selectively included in an
         export; nothing is scanned in the background. READ_MEDIA_IMAGES is
         the API 33+ scoped-storage permission; READ_EXTERNAL_STORAGE covers
         31-32 only (minSdk is 31, so this fallback is required, not optional). -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <!-- Keeps a capture session alive when the user switches to the meeting
         or video app. mediaProjection covers the opt-in device-audio lane,
         which only ever activates after the system consent dialog. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <!--
        REL-10: the post-capture merge keeps the service foreground after the mic is released,
        so a keynote-scale summarization (minutes of on-device model calls) isn't killed when
        the user leaves the app. Normal-protection, no user prompt, and NOT a network
        capability — "data sync" here means processing the user's own transcript on-device.
        The mic/mediaProjection types are dropped at that point so the privacy indicator
        stops implying TrailMix is still listening.
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <!-- CAP-12: required on Android 13+ for the capture notification (timer,
         pause/stop actions, and the "still recording?" nudge) to actually display —
         requested at runtime when a capture starts. A denial doesn't block recording,
         it just means no visible notification (the FGS keeps the mic alive either way). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".TrailMixApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.TrailMix">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.TrailMix"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".service.CaptureService"
            android:exported="false"
            android:foregroundServiceType="microphone|mediaProjection|dataSync" />
    </application>
</manifest>
